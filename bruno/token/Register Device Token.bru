meta {
  name: Register Device Token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/tokens
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-API-Key: {{appApiKey}}
}

body:json {
  {
    "external_id": "{{externalUserId}}",
    "token": "{{deviceToken}}",
    "platform": "{{platform}}"
  }
}

assert {
  res.status: 200
}
